# Needed only by src/commentary.py and /api/commentary/live.
# Leave empty on a public deployment: preset commentary is served from the
# committed data/commentary.json, and the live endpoint returns 503 rather
# than putting a billable key behind an open button.
ANTHROPIC_API_KEY=

# Browser origins allowed to call the API. Defaults to localhost:3000/3001.
# Set to the deployed frontend origin when hosting.
CORS_ORIGINS=
